# ─────────────────────────────────────────────────────────────
# Nexora Document → Image Converter — configuration
# Copy this file to .env and edit. Lines starting with # are ignored.
# ─────────────────────────────────────────────────────────────

# Web server
HOST=127.0.0.1          # 127.0.0.1 = this computer only. 0.0.0.0 = whole network (set APP_PASSWORD!)
PORT=3100

# Optional login (leave APP_PASSWORD empty to disable)
APP_USER=admin
APP_PASSWORD=

# Limits and behaviour
MAX_UPLOAD_MB=100       # largest file accepted
MAX_PAGES=300           # largest number of pages/images per file
JOB_TTL_MIN=30          # minutes before converted images are auto-deleted from temp
CONVERT_TIMEOUT_MS=180000

# Path to LibreOffice if it isn't on PATH, e.g. /usr/bin/soffice
# SOFFICE_BIN=soffice
